# ─────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in the real values.
# NEVER commit .env — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string → URI
# Use the "Connection pooling" / Session mode string if the direct one is slow.
# Replace [YOUR-PASSWORD] with the database password you set at project creation.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google AI Studio → Get API key  (https://aistudio.google.com/apikey)
# One key covers both the embedding model and the Gemini text models.
GOOGLE_API_KEY=

# Models — change only if you know why
EMBED_MODEL=text-embedding-004
EMBED_DIM=768
FAST_MODEL=gemini-2.0-flash
ANSWER_MODEL=gemini-2.0-flash
